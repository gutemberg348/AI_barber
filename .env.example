# Execute npm run setup para gerar os segredos locais sem sobrescrever .env.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
ADMIN_API_TOKEN=
# 64 caracteres hexadecimais. Preserve esta chave e o banco juntos no backup.
DATA_ENCRYPTION_KEY=
DATABASE_PATH=./data/luna.sqlite
LOG_LEVEL=info

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
LUNA_PROMPT_PATH=./prompts/luna.md
OPENAI_MAX_OUTPUT_TOKENS=1200

# Para outro site com o mesmo contrato, troque estes três campos.
BARBEARIA_API_URL=https://goodstyler.com/admin/api_ia.php
BARBEARIA_API_TOKEN=
BARBEARIA_SITE_URL=https://goodstyler.com
BARBEARIA_NOME=Good Style
BARBEARIA_DONO=Julio
BARBEARIA_TIMEZONE=America/Sao_Paulo
API_TIMEOUT_MS=15000

# Conecta ao iniciar e mostra o QR no terminal, sem depender do painel do site.
WHATSAPP_AUTO_CONNECT=true
# Quando usar o painel do site, defina false para não imprimir QR no terminal/logs.
WHATSAPP_PRINT_QR=true
MESSAGE_MAX_AGE_SECONDS=300
MAX_CONCURRENT_CHATS=4
MAX_PENDING_MESSAGES=100
CHAT_MESSAGES_PER_MINUTE=12
HISTORY_TTL_HOURS=24
RETENTION_DAYS=30
