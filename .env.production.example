# Gerado com: sh scripts/preparar-vps.sh
# Preencha OPENAI_API_KEY e BARBEARIA_API_TOKEN antes de subir.
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
# Porta interna do container. Na VPS o Compose publica em 127.0.0.1:3308.

# Login do painel https://ia.goodstyler.com/painel.
ADMIN_EMAIL=admin@admin
ADMIN_PASSWORD=admin
# Token separado da API. O preparador gera automaticamente.
ADMIN_API_TOKEN=
# Preserve com o volume de dados; não gere outra chave nas atualizações.
DATA_ENCRYPTION_KEY=
DATABASE_PATH=/app/data/luna.sqlite
LOG_LEVEL=info

# Cole aqui a chave da OpenAI que já usa para a Luna.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
LUNA_PROMPT_PATH=/app/prompts/luna.md
OPENAI_MAX_OUTPUT_TOKENS=1200

# Site consultado pela Luna: não é o domínio do painel.
BARBEARIA_API_URL=https://goodstyler.com/admin/api_ia.php
# Mesmo token configurado no PHP da hospedagem (BARBEARIA_IA_TOKEN).
BARBEARIA_API_TOKEN=
BARBEARIA_SITE_URL=https://goodstyler.com
BARBEARIA_NOME=Good Style
BARBEARIA_DONO=Julio
BARBEARIA_TIMEZONE=America/Sao_Paulo
API_TIMEOUT_MS=15000

# Pareamento pelo painel; não imprime QR nos logs da VPS.
WHATSAPP_AUTO_CONNECT=true
WHATSAPP_PRINT_QR=false
MESSAGE_MAX_AGE_SECONDS=300
MAX_CONCURRENT_CHATS=4
MAX_PENDING_MESSAGES=100
CHAT_MESSAGES_PER_MINUTE=12
HISTORY_TTL_HOURS=24
RETENTION_DAYS=30
